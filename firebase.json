{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase.blaze.json",
      "functions/**",
      "docs/**",
      ".git/**",
      "README.md",
      "CONTRIBUTING.md"
    ],
    "rewrites": [
      {
        "source": "/r/**",
        "destination": "/r.html"
      },
      {
        "source": "/p/**",
        "destination": "/p.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(self)" }
        ]
      },
      {
        "source": "**/*.@(js|css|svg|png|webp)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ]
  }
}
