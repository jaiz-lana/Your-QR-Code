rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // File halaman hosting & logo: baca publik, tulis hanya oleh pemilik terautentikasi
    // Batas ukuran 10 MB, folder diizinkan, dan tipe MIME aman (PDF/Gambar)
    match /{folder}/{uid}/{fileName} {
      allow read: if folder in ['hosted', 'logos', 'uploads'];
      allow write: if folder in ['hosted', 'logos', 'uploads']
                   && request.auth != null
                   && request.auth.uid == uid
                   && request.resource != null
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf|image/png|image/jpeg|image/webp|image/svg\\+xml');
      allow delete: if folder in ['hosted', 'logos', 'uploads']
                    && request.auth != null
                    && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
