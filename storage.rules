rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // File halaman hosting & logo: baca publik, tulis hanya oleh pemilik terautentikasi
    // Batas ukuran 10 MB dan tipe MIME aman (PDF/Gambar)
    match /{folder}/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource != null
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf|image/png|image/jpeg|image/webp|image/svg\\+xml');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
